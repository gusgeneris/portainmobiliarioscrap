{
  "title": "Portalinmobiliario Property Scraper",
  "description": "Scrape property data from portalinmobiliario.com by place, URL, or specific listing URLs.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "scrapeMode": {
      "title": "Scrape mode",
      "type": "string",
      "description": "overview (search cards only) or detail (opens each listing).",
      "default": "overview",
      "enum": [
        "overview",
        "detail"
      ],
      "editor": "select"
    },
    "searchMode": {
      "title": "Search by",
      "type": "string",
      "description": "Build URL by place, use a full search URL, or provide listing URLs.",
      "default": "byPlace",
      "enum": [
        "byPlace",
        "bySearchUrl",
        "byListingUrl"
      ],
      "editor": "select"
    },
    "operation": {
      "title": "Operation",
      "type": "string",
      "description": "Used when searchMode=byPlace.",
      "default": "venta",
      "enum": [
        "venta",
        "arriendo",
        "arriendo-temporal"
      ],
      "editor": "select"
    },
    "propertyType": {
      "title": "Property type",
      "type": "string",
      "description": "Used when searchMode=byPlace.",
      "default": "departamento",
      "enum": [
        "departamento",
        "casa",
        "oficina",
        "terreno",
        "parcela",
        "local",
        "bodega"
      ],
      "editor": "select"
    },
    "location": {
      "title": "Location slug",
      "type": "string",
      "description": "Example: santiago-metropolitana",
      "default": "santiago-metropolitana",
      "editor": "textfield"
    },
    "condition": {
      "title": "Condition",
      "type": "string",
      "description": "Optional condition path segment in byPlace mode.",
      "default": "any",
      "enum": [
        "any",
        "propiedades-usadas",
        "propiedades-nuevas"
      ],
      "editor": "select"
    },
    "modality": {
      "title": "Modalidad",
      "type": "string",
      "description": "Filtro general: usadas, nuevas o proyectos (byPlace).",
      "default": "any",
      "enum": [
        "any",
        "propiedades-usadas",
        "propiedades-nuevas",
        "proyectos"
      ],
      "editor": "select"
    },
    "minPrice": {
      "title": "Precio mínimo",
      "type": "number",
      "description": "Filtro por precio mínimo en la moneda del aviso."
    },
    "maxPrice": {
      "title": "Precio máximo",
      "type": "number",
      "description": "Filtro por precio máximo en la moneda del aviso."
    },
    "minBedrooms": {
      "title": "Dormitorios mínimo",
      "type": "integer",
      "description": "Cantidad mínima de dormitorios."
    },
    "maxBedrooms": {
      "title": "Dormitorios máximo",
      "type": "integer",
      "description": "Cantidad máxima de dormitorios."
    },
    "minBathrooms": {
      "title": "Baños mínimo",
      "type": "integer",
      "description": "Cantidad mínima de baños."
    },
    "maxBathrooms": {
      "title": "Baños máximo",
      "type": "integer",
      "description": "Cantidad máxima de baños."
    },
    "minParking": {
      "title": "Estacionamientos mínimo",
      "type": "integer",
      "description": "Cantidad mínima de estacionamientos."
    },
    "searchUrl": {
      "title": "Search URL",
      "type": "string",
      "description": "Used when searchMode=bySearchUrl.",
      "editor": "textfield"
    },
    "listingUrls": {
      "title": "Listing URLs",
      "type": "array",
      "description": "Used when searchMode=byListingUrl.",
      "editor": "stringList",
      "items": {
        "type": "string"
      }
    },
    "maxResults": {
      "title": "Max results",
      "type": "integer",
      "description": "Maximum number of items to output.",
      "default": 5,
      "minimum": 1
    },
    "maxPages": {
      "title": "Max search pages",
      "type": "integer",
      "description": "Only used for byPlace and bySearchUrl.",
      "default": 5,
      "minimum": 1
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Optional Apify proxy settings.",
      "editor": "proxy"
    }
  }
}
